N8N_EMAIL_WEBHOOK_URL=https://.../webhook/...
N8N_JWT_SECRET=<lo stesso secret della credenziale JWT Auth>

# Connessione al database come ruolo `wishlist_service` (non `postgres`): i
# grant e le policy dello schema sono scritti su quel ruolo, ed è ciò che
# limita cosa la landing può fare se le credenziali trapelano.
#
# Con il pooler di Supabase (consigliato in serverless, porta 6543) l'utente
# va qualificato col project ref: `wishlist_service.<project-ref>`.
# La connessione diretta (porta 5432 su db.<project-ref>.supabase.co, utente
# `wishlist_service` senza suffisso) risolve solo su IPv6: dove non c'è — un
# runtime serverless, molte reti domestiche — il nome non risolve affatto
# (`ENOTFOUND`). Il pooler ha anche record A, ed è l'unico che funziona ovunque.
DATABASE_URL=postgresql://wishlist_service.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require
