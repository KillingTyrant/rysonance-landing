# Mailchimp è l'unico posto in cui la wishlist esiste: senza queste due
# variabili nessuno può iscriversi (il form mostra l'errore di salvataggio).
#
# Profile → Extras → API keys. La chiave finisce col datacenter
# dell'account (`…-us21`), da cui si ricava l'host dell'API: va incollata intera.
MAILCHIMP_API_KEY=<chiave>-us21
# Audience → Settings → Audience name and defaults → «Audience ID».
MAILCHIMP_AUDIENCE_ID=<audience-id>
